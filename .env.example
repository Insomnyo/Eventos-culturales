# =====================================================================
#  Telón · Plataforma de eventos culturales (versión LOCAL: XAMPP + MySQL)
#  Copiá este archivo como ".env" en la raíz y completá los valores.
#  NUNCA subas ".env" al repositorio.
#
#  Variables que empiezan con VITE_ -> se PUBLICAN en el navegador (solo valores públicos).
#  El resto es PRIVADO y solo lo lee el backend.
# =====================================================================

# ---------- Backend (privadas) ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Base de datos (XAMPP: root sin contraseña por defecto). Mejor crear el usuario "telon_app" (ver SQL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telon_eventos

# Secreto para firmar los JWT y las URLs de imágenes. OBLIGATORIO y único por entorno.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# URLs. Usá SIEMPRE "localhost" (no mezcles con 127.0.0.1: las cookies no se comparten).
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY=0

# Reglas de negocio
MAX_TICKETS_PER_USER=2
EVENT_TIMEZONE=America/Argentina/Buenos_Aires
UPLOADS_DIR=./uploads

# Emails (SMTP). Si SMTP_HOST está vacío, los correos NO se envían: el enlace de verificación
# se imprime en la consola del backend y se guarda en backend/mail-outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Telón <entradas@tu-dominio.com>"

# hCaptcha (opcional en local). Secret SOLO en backend.
HCAPTCHA_SECRET=

# ---------- Frontend (públicas) ----------
VITE_API_URL=http://localhost:3000/api
VITE_HCAPTCHA_SITE_KEY=
